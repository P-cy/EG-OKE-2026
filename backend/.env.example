# ── App ────────────────────────────────────────────────────────────────
ENV=development                 # development | staging | production
DEBUG=true
ENABLE_DOCS=true                # ★ ตั้ง false ใน production
# คั่นด้วยจุลภาคได้ถ้าต้องเปิดจากมือถือผ่าน LAN IP ตอนทดสอบหน้างาน
# เช่น FRONTEND_ORIGIN=http://localhost:3000,http://192.168.1.20:3000
FRONTEND_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000

# ── Database ───────────────────────────────────────────────────────────
MONGO_URI=mongodb://root:changeme@localhost:27017/egoke2026?authSource=admin
MONGO_DB=egoke2026
MONGO_MAX_POOL=100
MONGO_MIN_POOL=10

# production (replica set):
# MONGO_URI=mongodb://user:pass@app-1:27017,app-2:27017/egoke2026?replicaSet=rs0&authSource=admin&retryWrites=true&w=majority

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ── Auth ───────────────────────────────────────────────────────────────
# สร้างด้วย: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ACCESS_TOKEN_TTL_SECONDS=900            # 15 นาที
REFRESH_TOKEN_TTL_DAYS=30
TOKEN_VERSION=1                          # เพิ่มเลขนี้ = kill token ทุกใบทันที

GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
# ปล่อยว่าง = รับอีเมลทุก domain (ค่าที่ใช้อยู่)
# ใส่ค่าเช่น student.mahidol.ac.th,mahidol.ac.th เพื่อจำกัดเฉพาะมหิดล
ALLOWED_EMAIL_DOMAINS=
# ★ อีเมลที่เป็น admin อัตโนมัติตอน login — คั่นด้วยจุลภาค (promote เท่านั้น ไม่ demote)
#    ใส่เมลจริงที่จะใช้ login ด้วย Google OAuth
ADMIN_EMAILS=phatthanasak.kra@student.mahidol.ac.th

# ── QR / Check-in ──────────────────────────────────────────────────────
QR_SIGNING_KEY=CHANGE_ME_openssl_rand_hex_32
QR_VERSION=1                             # เพิ่ม = ยกเลิก QR เก่าทั้งหมด
TOTP_KEY=CHANGE_ME_openssl_rand_hex_32
TOTP_PERIOD=30
TOTP_WINDOW=1                            # ยอมรับ ±1 period เผื่อนาฬิกาเพี้ยน
STRICT_QR_MODE=false                     # true = บังคับใส่ rotating code
CHECKIN_COINS=10

# ── โควตาการจ่ายเหรียญของ staff (กันเหรียญเฟ้อ / กันจ่ายให้พวกพ้อง) ─────
# staff_grant เป็นทางเดียวที่เหรียญเข้าระบบได้แบบไม่มีเพดานในตัว
# (เช็คอินปิดด้วย dedupe รายวัน / วงล้อ EV ติดลบ + 3 ครั้งต่อคน)
STAFF_GRANT_MAX_PER_SCAN=200        # ต่อการสแกน 1 ครั้ง — กันพิมพ์ผิดหลัก
STAFF_GRANT_PER_USER_DAILY=300      # ★ staff คนหนึ่ง -> คนหนึ่ง ต่อวัน (ด่านกันจ่ายให้เพื่อน)
USER_GRANT_RECEIVE_DAILY=1500       # ★ คนหนึ่งรับรวมทุกบูธ ต่อวัน (ด่านกันไล่เก็บจาก staff หลายคน)
STAFF_GRANT_DAILY_BUDGET=20000      # staff คนหนึ่งจ่ายรวม ต่อวัน (เบรกเกอร์ ตั้งหลวมไว้ไม่ให้ขวางบูธ)

# ── Wheel ──────────────────────────────────────────────────────────────
WHEEL_SERVER_SEED=CHANGE_ME_openssl_rand_hex_32

# ── Attendance ─────────────────────────────────────────────────────────
# ลิงก์ Google Form สำหรับฟอร์ม Attendance — แปะลิงก์ที่จะเด้งให้คนเข้างานกรอกหลังเช็คอิน
# (ว่าง = ปุ่ม "ไปกรอกฟอร์ม" ถูกซ่อน)
ATTENDANCE_FORM_URL=

# ── Privacy ────────────────────────────────────────────────────────────
IP_PEPPER=CHANGE_ME_openssl_rand_hex_16  # ★ ห้ามเปลี่ยนหลังใช้งานจริง

# ── Feature flags (ค่าเริ่มต้น — override ได้จาก /admin/config) ────────
REQUIRE_CHECKIN_TO_VOTE=false
IG_SUBMISSIONS_PER_DAY=5
# ★ ถอด IG_APPROVED_COINS ออกแล้ว — การขึ้นจอเป็นของที่ "ซื้อ" ด้วยเหรียญ ไม่ใช่รางวัล

# ── Realtime ───────────────────────────────────────────────────────────
SNAPSHOT_INTERVAL_MS=1000
WS_HEARTBEAT_SECONDS=20
WS_MAX_QUEUE=50
DISPLAY_TOKEN=CHANGE_ME_long_random_string

# ── Ops ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SENTRY_DSN=
METRICS_ALLOWED_IPS=127.0.0.1,10.0.0.0/8
