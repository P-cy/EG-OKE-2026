# Base URL ของ backend API (ต้องมี /v1 ต่อท้าย)
#
# ★ ค่านี้ถูกฝังลงไฟล์ JS ตอน `next build` ไม่ได้อ่านตอนรัน
#   เปลี่ยนค่าแล้วต้อง build ใหม่เสมอ — ตั้งใน environment ของ server ไม่มีผล
#   (next.config.mjs ประกาศไว้ใน env: {} ยิ่งทำให้ถูก inline ตั้งแต่ตอน build)
#
# ★ โดเมนนี้ต้องอยู่ใต้โดเมนจดทะเบียนเดียวกับหน้าเว็บ
#   refresh token เป็น cookie SameSite=Lax เบราว์เซอร์จะส่งข้ามให้ก็ต่อเมื่อ
#   สองฝั่งเป็น "site" เดียวกัน
#     ใช้ได้:   หน้าเว็บ app.egoke2026.com  +  API api.egoke2026.com
#     พังเงียบ: หน้าเว็บ egoke.vercel.app   +  API api.egoke2026.com
#               (คนละ site → ไม่ส่ง cookie → หลุด login ทุก 15 นาที ไม่มี error ให้เห็น)
#   ถ้าจะ deploy บน Vercel ให้ผูก custom domain เป็น app.<โดเมนของคุณ> ก่อน

NEXT_PUBLIC_API_BASE=http://localhost:8000/v1

# ตอน production:
# NEXT_PUBLIC_API_BASE=https://api.egoke2026.com/v1
